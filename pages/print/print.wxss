.print-container {
  position: relative;
  min-height: 100vh;
  overflow: hidden;
}

.page-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

.print-content {
  position: relative;
  z-index: 1;
  padding: 20rpx;
  display: flex;
  justify-content: center;
}

.a4-paper {
  width: 96vw;
  max-width: 1000rpx;
  background: #fff;
  border: 3rpx solid #d4d4d4;
  border-radius: 12rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.15);
  padding: 16rpx;
  box-sizing: border-box;
  margin: 200rpx auto 40rpx auto;
  display: block;
}

.print-image {
  width: 100%;
  height: auto;
  display: block;
  border-radius: 4rpx;
}

.a4-stack .a4-paper + .a4-paper {
  margin-top: 40rpx;
  margin-bottom: 40rpx;
}
