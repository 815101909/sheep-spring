page {
  height: 100vh;
  background: transparent;
}
.background-container {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 1;
}
.background-image {
  width: 100%;
  height: 100%;
  opacity: 0.35;
}
.background-container.dark::after {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(0, 0, 0, 0.35);
}
.page-container {
  position: relative;
  z-index: 2;
  padding: 40rpx 30rpx;
  height: 100vh;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}
.header {
  background: rgba(255, 255, 255, 0.9);
  border-radius: 16rpx;
  padding: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
  margin-bottom: 20rpx;
}
.page-container.dark .header {
  background: rgba(24, 24, 24, 0.92);
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.4);
}
.title-row {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}
.header-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 14rpx;
  margin-right: 12rpx;
  border: 4rpx solid rgba(255,255,255,0.9);
}
.header-title {
  font-size: 30rpx;
  color: #2c3e50;
  font-weight: bold;
}
.page-container.dark .header-title {
  color: #e6edf3;
}
.separator {
  font-size: 24rpx;
  color: #7f8c8d;
  margin: 0 8rpx;
}
.page-container.dark .separator {
  color: #8b949e;
}
.header-sub {
  font-size: 26rpx;
  color: #7f8c8d;
}
.page-container.dark .header-sub {
  color: #8b949e;
}
.header-status {
  font-size: 22rpx;
  color: #34495e;
}
.page-container.dark .header-status {
  color: #c9d1d9;
}
.loading-tip, .empty-tip {
  font-size: 26rpx;
  color: #34495e;
  text-align: center;
  padding: 20rpx 0;
}
.page-container.dark .loading-tip, .page-container.dark .empty-tip {
  color: rgba(255, 255, 255, 0.9);
}
.grid-scroll {
  flex: 1;
  overflow: hidden;
}
.grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 24rpx;
  padding-bottom: 20rpx;
}
.medal-card {
  background: rgba(255, 253, 240, 0.8);
  border-radius: 16rpx;
  padding: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
  display: flex;
  flex-direction: column;
  align-items: center;
}
.page-container.dark .medal-card {
  background: rgba(36, 36, 36, 0.9);
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.35);
}
.medal-badge {
  width: 180rpx;
  height: 180rpx;
  border-radius: 50%;
  background: #ffffff;
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.15), inset 0 0 0 4rpx rgba(255, 255, 255, 0.9);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12rpx;
}
.page-container.dark .medal-badge {
  background: #1f1f1f;
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.4), inset 0 0 0 4rpx rgba(255, 255, 255, 0.08);
}
.medal-icon {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
}
.medal-title {
  font-size: 26rpx;
  color: #2c3e50;
  text-align: center;
  margin-bottom: 8rpx;
}
.page-container.dark .medal-title {
  color: #e6edf3;
}
.medal-time {
  font-size: 22rpx;
  color: #7f8c8d;
  margin-bottom: 6rpx;
}
.page-container.dark .medal-time {
  color: #8b949e;
}
.medal-action {
  font-size: 22rpx;
  color: #2980b9;
}
.page-container.dark .medal-action {
  color: #58a6ff;
}
