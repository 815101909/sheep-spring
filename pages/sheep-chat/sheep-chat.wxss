/* pages/sheep-chat/sheep-chat.wxss */
.container {
  min-height: 100vh;
  background: linear-gradient(135deg, #fff0f5 0%, #f0f8ff 50%, #f5f5f5 100%);
  position: relative;
  padding: 20rpx;
  box-sizing: border-box;
}

.bg-image {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  opacity: 0.2;
  z-index: 1;
}

/* 功能选择界面样式 - 圆形布局 */
.feature-selection {
  position: relative;
  z-index: 2;
  padding: 40rpx 0;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.circle-layout {
  position: relative;
  width: 100%;
  height: 100vh;
  max-width: 600rpx;
  margin: 0 auto;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 中心绵羊 */
.center-sheep {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  text-align: center;
  z-index: 100;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.sheep-avatar {
  width: 160rpx;
  height: 160rpx;
  margin: 0 auto 20rpx;
  animation: float 4s ease-in-out infinite;
}

@keyframes float {
  0%, 100% { transform: translateY(0px) rotate(0deg); }
  25% { transform: translateY(-10px) rotate(5deg); }
  50% { transform: translateY(-15px) rotate(0deg); }
  75% { transform: translateY(-10px) rotate(-5deg); }
}

.welcome-text {
  font-size: 32rpx;
  color: #666;
  font-weight: 500;
  display: block;
}

/* 围绕功能选项 */
.orbiting-features {
  position: relative;
  width: 100%;
  height: 100%;
}

/* 功能卡片轨道容器 - 围绕中心绵羊 */
.orbiting-features {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 400rpx;
  height: 400rpx;
  transform: translate(-50%, -50%);
  /* 移除轨道整体旋转动画 */
  z-index: 50;
}

/* 为每个卡片单独添加公转动画 */
.feature-orbit {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 180rpx;
  height: 180rpx;
  transform-origin: center;
}

.feature-orbit[data-index="0"] {
  /* 第一个卡片在右边 */
  transform: translate(-50%, -50%) rotate(0deg) translateX(200rpx) rotate(0deg);
  animation: cardOrbit0 20s linear infinite;
}

.feature-orbit[data-index="1"] {
  /* 第二个卡片在左上方 */
  transform: translate(-50%, -50%) rotate(120deg) translateX(200rpx) rotate(-120deg);
  animation: cardOrbit1 20s linear infinite;
}

.feature-orbit[data-index="2"] {
  /* 第三个卡片在左下方 */
  transform: translate(-50%, -50%) rotate(240deg) translateX(200rpx) rotate(-240deg);
  animation: cardOrbit2 20s linear infinite;
}

@keyframes cardOrbit0 {
  from { transform: translate(-50%, -50%) rotate(0deg) translateX(200rpx) rotate(0deg); }
  to { transform: translate(-50%, -50%) rotate(360deg) translateX(200rpx) rotate(-360deg); }
}

@keyframes cardOrbit1 {
  from { transform: translate(-50%, -50%) rotate(120deg) translateX(200rpx) rotate(-120deg); }
  to { transform: translate(-50%, -50%) rotate(480deg) translateX(200rpx) rotate(-480deg); }
}

@keyframes cardOrbit2 {
  from { transform: translate(-50%, -50%) rotate(240deg) translateX(200rpx) rotate(-240deg); }
  to { transform: translate(-50%, -50%) rotate(600deg) translateX(200rpx) rotate(-600deg); }
}



.feature-card {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 180rpx;
  height: 180rpx;
  padding: 25rpx;
  border-radius: 20rpx;
  text-align: center;
  box-shadow: 0 8rpx 25rpx rgba(0,0,0,0.15);
  transition: all 0.3s ease;
  cursor: pointer;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  z-index: 100;
}

.feature-content {
  /* 抵消外层容器的旋转，确保内容始终正向显示 */
  transform: rotate(0deg);
  transform-origin: center;
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.feature-card:active {
  transform: translate(-50%, -50%) scale(0.95);
  box-shadow: 0 5rpx 20rpx rgba(0,0,0,0.2);
}

.click-overlay {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 200rpx;
  height: 200rpx;
  transform: translate(-50%, -50%);
  background: transparent;
  z-index: 20;
  cursor: pointer;
}

.feature-icon {
  font-size: 50rpx;
  margin-bottom: 12rpx;
  display: block;
}

.feature-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #fff;
  margin-bottom: 8rpx;
  text-shadow: 1rpx 1rpx 2rpx rgba(0,0,0,0.1);
}

.feature-desc {
  display: block;
  font-size: 20rpx;
  color: rgba(255,255,255,0.9);
  font-weight: 300;
  line-height: 1.3;
}

/* 装饰性圆环 */
.decorative-ring {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 400rpx;
  height: 400rpx;
  border: 2rpx solid rgba(255, 158, 181, 0.3);
  border-radius: 50%;
  animation: ringRotate 25s linear infinite;
  z-index: -10;
  pointer-events: none; /* 确保装饰环不拦截点击事件 */
}

.inner-ring {
  width: 300rpx;
  height: 300rpx;
  border-color: rgba(135, 206, 235, 0.3);
  animation: ringRotate 25s linear infinite reverse;
}

@keyframes ringRotate {
  from { transform: translate(-50%, -50%) rotate(0deg); }
  to { transform: translate(-50%, -50%) rotate(360deg); }
}

/* 漂浮装饰元素 */
.floating-elements {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.floating-element {
  position: absolute;
  font-size: 36rpx;
  opacity: 0.7;
  animation: floatGently 6s ease-in-out infinite;
}

@keyframes floatGently {
  0%, 100% { transform: translateY(0px) rotate(0deg) scale(1); opacity: 0.7; }
  50% { transform: translateY(-20px) rotate(180deg) scale(1.1); opacity: 0.4; }
}

/* 功能卡片悬停效果 */
.feature-card::before {
  content: '';
  position: absolute;
  top: -5rpx;
  left: -5rpx;
  right: -5rpx;
  bottom: -5rpx;
  border-radius: 25rpx;
  background: linear-gradient(45deg, #ff9eb5, #87ceeb, #98fb98, #ff9eb5);
  background-size: 300% 300%;
  animation: gradientShift 3s ease infinite;
  opacity: 0;
  transition: opacity 0.3s ease;
  z-index: -1;
}

.feature-card:hover::before {
  opacity: 0.3;
}

@keyframes gradientShift {
  0% { background-position: 0% 50%; }
  50% { background-position: 100% 50%; }
  100% { background-position: 0% 50%; }
}

.hint-text {
  text-align: center;
  color: #999;
  font-size: 28rpx;
  font-style: italic;
}

/* 聊天界面样式 */
.chat-interface {
  position: relative;
  z-index: 2;
  height: 100vh;
  display: flex;
  flex-direction: column;
}

.chat-header {
  display: flex;
  align-items: center;
  padding: 20rpx;
  background: rgba(255,255,255,0.8);
  border-radius: 20rpx;
  margin-bottom: 20rpx;
  backdrop-filter: blur(10px);
}

.back-btn {
  padding: 10rpx 20rpx;
  margin-right: 20rpx;
}

.back-icon {
  font-size: 36rpx;
  color: #ff9eb5;
}

.feature-info {
  flex: 1;
}

.feature-name {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.feature-subtitle {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-top: 5rpx;
}

.chat-container {
  flex: 1;
  margin-bottom: 20rpx;
}

.messages-list {
  padding: 20rpx;
}

.message-item {
  margin-bottom: 30rpx;
}

.message {
  display: flex;
  align-items: flex-end;
}

.sheep-message {
  justify-content: flex-start;
}

.user-message {
  justify-content: flex-end;
}

.message-avatar {
  width: 80rpx;
  height: 80rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.message-bubble {
  max-width: 70%;
  padding: 25rpx 30rpx;
  border-radius: 25rpx;
  position: relative;
}

.sheep-bubble {
  background: linear-gradient(135deg, #fff 0%, #f8f8f8 100%);
  border: 2rpx solid #e0e0e0;
  border-top-left-radius: 5rpx;
  box-shadow: 0 5rpx 15rpx rgba(0,0,0,0.05);
}

.user-bubble {
  background: linear-gradient(135deg, #ff9eb5 0%, #ff8aa8 100%);
  color: white;
  border-top-right-radius: 5rpx;
  box-shadow: 0 5rpx 15rpx rgba(255,158,181,0.3);
}

.message-text {
  font-size: 30rpx;
  line-height: 1.5;
  display: block;
}

.sheep-bubble .message-text {
  color: #333;
}

.message-time {
  font-size: 20rpx;
  color: #999;
  margin-top: 10rpx;
  text-align: right;
}

.sheep-bubble .message-time {
  text-align: left;
  color: #bbb;
}

/* 输入区域样式 */
.input-container {
  background: rgba(255,255,255,0.9);
  padding: 20rpx;
  border-radius: 30rpx;
  backdrop-filter: blur(10px);
  box-shadow: 0 -5rpx 20rpx rgba(0,0,0,0.05);
}

.input-wrapper {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.message-input {
  flex: 1;
  background: #f5f5f5;
  border-radius: 25rpx;
  padding: 20rpx 30rpx;
  font-size: 28rpx;
  border: none;
  outline: none;
}

.send-btn {
  background: linear-gradient(135deg, #ff9eb5 0%, #ff8aa8 100%);
  color: white;
  border: none;
  border-radius: 25rpx;
  padding: 20rpx 40rpx;
  font-size: 28rpx;
  font-weight: 500;
}

.send-btn::after {
  border: none;
}