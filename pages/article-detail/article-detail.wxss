}

.tip-text {
  font-size: 26rpx;
  font-weight: 500;
  line-height: 1.4;
  display: block;
  text-align: center;
}

.tip-arrow {
  position: absolute;
  bottom: -8rpx;
  right: 30rpx;
  width: 0;
  height: 0;
  border-left: 8rpx solid transparent;
  border-right: 8rpx solid transparent;
  border-top: 8rpx solid #ffffff;
}

.date-icon {
