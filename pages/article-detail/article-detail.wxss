}

.rm-item.rm-done {
  /* border-left-color: #2ecc71; */
}

.rm-top {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx; /* 增加一点间距 */
  justify-content: space-between; /* 两端对齐 */
}

.rm-top-left {
  display: flex;
  align-items: center;
