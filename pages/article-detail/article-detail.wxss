/* Pinyin-Character One-to-One Mapping Styles */
.pinyin-char-container {
  display: flex;
  flex-wrap: wrap;
  align-items: flex-end; /* Align bottom to keep characters in line */
  line-height: 1.2;
  gap: 4rpx 10rpx;
}

.pinyin-char-group {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin: 0;
}

/* 拼音缩进样式 */
.indent-marker-0 { margin-left: 60rpx; }
.indent-marker-1 { margin-left: 68rpx; }
.indent-marker-2 { margin-left: 76rpx; }

.line-break {
  width: 100%;
  height: 0;
  margin: 0;
}

.pinyin-text {
  font-size: 22rpx; /* Default small size for pinyin */
  color: #7f8c8d;
  margin-bottom: 2rpx;
  font-family: 'Courier New', monospace;
}

.char-text {
  font-size: 32rpx; /* Default size for char */
  color: #34495e;
}

/* Font size adjustments */
.pinyin-text.font-size-0 { font-size: 18rpx !important; }
.char-text.font-size-0 { font-size: 30rpx !important; }

.pinyin-text.font-size-1 { font-size: 21rpx !important; }
.char-text.font-size-1 { font-size: 34rpx !important; }

.pinyin-text.font-size-2 { font-size: 24rpx !important; }
.char-text.font-size-2 { font-size: 38rpx !important; }

/* Article pinyin fallback size overrides */
.article-pinyin.font-size-0 { font-size: 22rpx !important; }
.article-pinyin.font-size-1 { font-size: 26rpx !important; }
.article-pinyin.font-size-2 { font-size: 30rpx !important; }

/* 填色画布 */
.coloring-canvas {
  width: 100%;
  height: 100%;
  display: block;
}

.loading-tip {
