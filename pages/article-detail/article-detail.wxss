.animation-layer {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.8);
  z-index: 10000;
  overflow: hidden;
}
.falling-char {
  position: absolute;
  top: -100rpx;
  color: #87CEEB;
  opacity: 0.8;
  font-family: serif;
  text-shadow: 0 0 10rpx rgba(135, 206, 235, 0.8);
  animation: dropAndBounce ease-in forwards;
}
@keyframes dropAndBounce {
  0% {
    top: -100rpx;
    transform: translateX(0);
  }
  60% {
    top: calc(100vh - 580rpx);
    transform: translateX(0);
    animation-timing-function: ease-out;
  }
  80% {
    top: calc(100vh - 900rpx);
    transform: translateX(calc(250rpx * var(--bounce-dir, 1)));
  }
  100% {
    top: 100vh;
    transform: translateX(calc(350rpx * var(--bounce-dir, 1)));
    opacity: 0;
  }
}
.plants-container {
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 250rpx;
  display: flex;
  justify-content: space-around;
  align-items: flex-end;
  pointer-events: none;
}
.plant {
  position: absolute;
  bottom: 0;
  width: 60rpx;
  height: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  transform-origin: bottom center;
  animation: growPlant 1.2s cubic-bezier(0.34, 1.56, 0.64, 1) forwards, plantSway 4s ease-in-out infinite alternate 1.2s;
  z-index: 10;
}
@keyframes plantSway {
  0% { transform: scale(var(--plant-scale)) rotate(-2deg); }
  100% { transform: scale(var(--plant-scale)) rotate(2deg); }
}
@keyframes growPlant {
  0% { height: 0; transform: scale(var(--plant-scale)); }
  100% { height: var(--plant-height, 120rpx); transform: scale(var(--plant-scale)); }
}
.stem {
  width: 4rpx;
  height: 100%;
  background: #88c999;
  border-radius: 4rpx;
  position: relative;
  z-index: 1;
}
.leaf {
  position: absolute;
  background: #88c999;
  opacity: 0;
  animation: leafGrow 0.4s ease-out 0.8s forwards;
  z-index: 0;
}
.leaf-left {
  width: 20rpx;
  height: 10rpx;
  border-radius: 0 50% 0 50%;
  left: -16rpx;
  bottom: 30%;
  transform: rotate(-10deg);
}
.leaf-right {
  width: 20rpx;
  height: 10rpx;
  border-radius: 0 50% 0 50%;
  right: -16rpx;
  bottom: 50%;
  transform: rotate(190deg);
}
.leaf-long {
  width: 12rpx;
  height: 60rpx;
  background: #88c999;
  border-radius: 50% 50% 0 0;
  bottom: 0;
  left: -8rpx;
  transform-origin: bottom center;
  transform: rotate(-15deg);
}
.flower {
  position: absolute;
  top: 0;
  left: 50%;
  transform: translate(-50%, -50%) scale(0);
  z-index: 2;
  display: flex;
  justify-content: center;
  align-items: center;
  animation: bloomFlower 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) 1s forwards;
}
.plant-type-1 .flower {
  width: 50rpx;
  height: 50rpx;
}
.plant-type-1 .flower::after {
  content: '';
  position: absolute;
  width: 12rpx;
  height: 12rpx;
  background: #ffeb3b;
  border-radius: 50%;
  z-index: 2;
  box-shadow: 0 0 2rpx rgba(0,0,0,0.2);
}
.plant-type-1 .flower::before {
  content: '';
  position: absolute;
  width: 100%;
  height: 100%;
  background: conic-gradient(
    var(--petal-color) 0deg 30deg, transparent 30deg 45deg,
    var(--petal-color) 45deg 75deg, transparent 75deg 90deg,
    var(--petal-color) 90deg 120deg, transparent 120deg 135deg,
    var(--petal-color) 135deg 165deg, transparent 165deg 180deg,
    var(--petal-color) 180deg 210deg, transparent 210deg 225deg,
    var(--petal-color) 225deg 255deg, transparent 255deg 270deg,
    var(--petal-color) 270deg 300deg, transparent 300deg 315deg,
    var(--petal-color) 315deg 345deg, transparent 345deg 360deg
  );
  border-radius: 50%;
  mask: radial-gradient(transparent 20%, black 21%);
  -webkit-mask: radial-gradient(transparent 20%, black 21%);
}
.plant-type-2 .stem {
  background: #a2d5ab;
  width: 6rpx;
}
.plant-type-2 .flower {
  width: 40rpx;
  height: 50rpx;
  background: transparent;
  overflow: visible;
}
.plant-type-2 .petal,
.plant-type-2 .flower::before,
.plant-type-2 .flower::after {
  content: '';
  position: absolute;
  bottom: 0;
  width: 24rpx;
  height: 46rpx;
  border-radius: 50% 50% 10rpx 10rpx;
  transform-origin: bottom center;
}
.plant-type-2 .flower::before {
  left: 2rpx;
  background: var(--flower-dark);
  transform: rotate(-20deg);
  z-index: 1;
}
.plant-type-2 .flower::after {
  right: 2rpx;
  background: var(--flower-dark);
  transform: rotate(20deg);
  z-index: 1;
}
.plant-type-2 .petal {
  left: 50%;
  transform: translateX(-50%);
  width: 26rpx;
  height: 50rpx;
  background: linear-gradient(to top, var(--flower-mid), var(--flower-light));
  z-index: 2;
  box-shadow: 0 2rpx 6rpx rgba(0,0,0,0.15);
}
.plant-type-3 .stem {
  background: #90d0ac;
  height: 80%;
  border-radius: 4rpx 4rpx 0 0;
}
.plant-type-3 .flower {
  width: 40rpx;
  height: 60rpx;
  top: 20rpx;
  transform-origin: top center;
  animation: bloomFlower 0.6s ease-out 1s forwards, plantSwayBell 2s ease-in-out infinite alternate 1.6s;
}
.plant-type-3 .flower::before {
  content: '';
  position: absolute;
  top: 0;
  left: 50%;
  width: 20rpx;
  height: 30rpx;
  border-top: 4rpx solid #90d0ac;
  border-left: 4rpx solid #90d0ac;
  border-radius: 20rpx 0 0 0;
  transform: translateX(-50%) rotate(-10deg);
}
.plant-type-3 .petal {
  position: absolute;
  width: 14rpx;
  height: 14rpx;
  background: #fff;
  border-radius: 50% 50% 2rpx 2rpx;
  box-shadow: 0 2rpx 4rpx rgba(0,0,0,0.1);
}
.plant-type-3 .petal:nth-child(1) { top: 10rpx; left: 0rpx; transform: rotate(-30deg); }
.plant-type-3 .petal:nth-child(2) { top: 25rpx; left: -8rpx; transform: rotate(-45deg); }
.plant-type-3 .petal:nth-child(3) { top: 40rpx; left: -4rpx; transform: rotate(-60deg); }
.plant-type-1.plant-color-0 { --petal-color: #ff9a9e; }
.plant-type-1.plant-color-1 { --petal-color: #a18cd1; }
.plant-type-1.plant-color-2 { --petal-color: #fbc2eb; }
.plant-type-2.plant-color-0 { --flower-dark: #ff758c; --flower-mid: #ff7eb3; --flower-light: #ffdae0; }
.plant-type-2.plant-color-1 { --flower-dark: #f794a4; --flower-mid: #fdd6bd; --flower-light: #fff0e6; }
.plant-type-2.plant-color-2 { --flower-dark: #764ba2; --flower-mid: #667eea; --flower-light: #e0c3fc; }
.plant-type-3 .petal { background: #fff; }
@keyframes plantSwayBell {
  0% { transform: translate(-50%, -50%) rotate(-10deg); }
  100% { transform: translate(-50%, -50%) rotate(10deg); }
}
@keyframes leafGrow {
  to { opacity: 1; }
}
@keyframes bloomFlower {
  to { transform: translate(-50%, -50%) scale(1); }
}
.running-sheep-container {
  position: absolute;
  bottom: 10rpx;
  left: -200rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  animation: sheepWalkFlow 12s linear forwards;
  z-index: 5;
}
.running-sheep-image {
  width: 520rpx;
  height: 520rpx;
  animation: sheepBob 0.6s ease-in-out infinite alternate;
}
.encouraging-text {
  position: absolute;
  top: 40%;
  left: 50%;
  transform: translate(-50%, -50%) scale(0);
  font-size: 40rpx;
  color: #fff;
  text-align: center;
  text-shadow: 0 4rpx 8rpx rgba(0,0,0,0.3);
  font-weight: bold;
  opacity: 0;
  white-space: normal;
  word-wrap: break-word;
  width: 80%;
  line-height: 1.4;
  z-index: 10001;
  animation: popInAndOut 6s ease-in-out forwards;
}
@keyframes popInAndOut {
  0% { transform: translate(-50%, -50%) scale(0); opacity: 0; }
  15% { transform: translate(-50%, -50%) scale(1.2); opacity: 1; }
  25% { transform: translate(-50%, -50%) scale(1); opacity: 1; }
  85% { transform: translate(-50%, -50%) scale(1); opacity: 1; }
  100% { transform: translate(-50%, -50%) scale(1.5); opacity: 0; }
}
@keyframes sheepWalkFlow {
  0% { left: -550rpx; }
  100% { left: 120%; }
}
@keyframes sheepBob {
