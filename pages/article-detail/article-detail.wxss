  height: 28rpx;
}

@media (max-width: 768px) {
  .a4-paper {
    width: 90vw;
    height: 127vw;
    padding: 30rpx;
  }

  .a4-default-image {
    width: 280rpx;
    height: 280rpx;
    bottom: -220rpx;
    right: -35rpx;
  }

  .tip-label {
    bottom:300rpx;
