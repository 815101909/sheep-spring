/* pages/article-detail/article-detail.wxss */

/* CSS Heart Shape */
.css-heart {
  position: relative;
  width: 24rpx;
  height: 24rpx;
  background-color: #34495e;
  margin-top: 8rpx; /* Adjust vertical alignment */
}

.css-heart::before,
.css-heart::after {
  content: "";
  position: absolute;
  width: 24rpx;
  height: 24rpx;
  background-color: #34495e;
  border-radius: 50%;
}

.css-heart::before {
  top: -12rpx;
  left: 0;
}

.css-heart::after {
  left: -12rpx;
  top: 0;
}

/* Filled/Favorited State */
.css-heart.filled,
.css-heart.filled::before,
.css-heart.filled::after {
  background-color: #e74c3c;
}

/* Ensure color transition */
.css-heart, .css-heart::before, .css-heart::after {
  transition: background-color 0.3s ease;
}

page {
  min-height: 100vh;
}

/* 增大爱心尺寸 */
.action-btn.favorite-btn .css-heart {
  transform: rotate(45deg) scale(1.2); /* 放大到 1.2 倍 */
}

/* 调整 A4 卡片模式下的爱心尺寸 */
.a4-action-btn.favorite-btn .css-heart {
  transform: rotate(45deg) scale(1.2); /* 放大到 1.2 倍 */
}
.css-print {
  position: relative;
  width: 44rpx;
  height: 30rpx;
  background-color: #34495e;
  border-radius: 6rpx;
}
.css-print::after {
  content: "";
  position: absolute;
  top: -10rpx;
  left: 6rpx;
  right: 6rpx;
  height: 10rpx;
  background-color: #34495e;
  border-radius: 4rpx 4rpx 0 0;
}
.css-print::before {
  content: "";
  position: absolute;
  left: 6rpx;
  right: 6rpx;
  bottom: -12rpx;
  height: 20rpx;
  background-color: #ffffff;
  border: 2rpx solid #34495e;
  border-radius: 2rpx;
  box-shadow: inset 0 -6rpx 0 0 rgba(0,0,0,0.08);
}

/* 复古闪烁动画 */
@keyframes blink {
  0%, 50% { opacity: 1; }
  51%, 100% { opacity: 0.7; }
}

/* 背景层 */
.background-container {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100vh;
  z-index: -1;
  opacity: 0.3;
}

.background-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

/* 主容器布局 */
.main-content {
  display: flex;
  flex-direction: column;
  height: calc(100vh - 85rpx);
  margin-top: 55rpx;
  overflow: hidden;
  min-height: 0;
  box-sizing: border-box;
  padding-bottom: 50rpx;
  padding-bottom: calc(50rpx + env(safe-area-inset-bottom));
}

.main-content.a4-mode {
  height: 100vh;
  margin-top: 0;
  padding-bottom: 0;
  overflow: hidden;
}

/* 侧边栏样式 */
.sidebar {
  width: 620rpx;
  background: transparent;
  border: 4rpx solid rgba(255, 255, 255, 0.8);
  border-radius: 0;
  margin: 130rpx auto 10rpx auto;
  padding: 30rpx 20rpx;
  box-shadow:
    0 0 0 2rpx rgba(0, 0, 0, 0.5),
    inset 0 0 0 2rpx rgba(255, 255, 255, 0.3);
  image-rendering: pixelated;
  flex-shrink: 0;
}

.mode-selector {
  display: flex;
  flex-direction: row;
  gap: 15rpx;
  justify-content: center;
  flex-wrap: wrap;
  row-gap: 20rpx;
}

.mode-btn {
  padding: 16rpx 14rpx;
  background: rgba(0, 0, 0, 0.3);
  border: 3rpx solid rgba(255, 255, 255, 0.6);
  border-radius: 0;
  font-size: 24rpx;
  font-weight: bold;
  cursor: pointer;
  transition: all 0.2s ease;
  box-shadow:
    0 0 0 2rpx rgba(0, 0, 0, 0.2),
    inset 0 0 0 2rpx rgba(255, 255, 255, 0.2);
  backdrop-filter: blur(5rpx);
  display: flex;
  align-items: center;
  justify-content: center;
  color: rgba(255, 255, 255, 0.8);
  text-align: center;
  position: relative;
  overflow: visible;
  white-space: nowrap;
  font-family: 'Courier New', monospace;
  text-transform: uppercase;
  letter-spacing: 1rpx;
  image-rendering: pixelated;
}

/* 风格图片样式 */
.style-image-container {
  position: absolute;
  top: -95rpx;
  left: 50%;
  transform: translateX(calc(-50% - 4rpx));
  display: none;
  justify-content: center;
  z-index: 100;
}

.style-image-container.visible {
  display: flex;
}

.style-image {
  width: 140rpx;
  height: 110rpx;
  border-radius: 8rpx;
}

.mode-btn:active {
