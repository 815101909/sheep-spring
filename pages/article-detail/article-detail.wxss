.rm-section {
  margin-top: 30rpx;
  margin-left: -20rpx; /* 向左扩展 */
  margin-right: -20rpx; /* 向右扩展 */
  padding: 20rpx 10rpx; /* 上下20，左右10，稍微留点空隙给阴影 */
  border-radius: 24rpx;
