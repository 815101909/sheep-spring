}

.rm-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background-color: #FFDAC1;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.rm-item.rm-done .rm-dot {
