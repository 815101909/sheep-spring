/* A4区域样式 */
.a4-mode {
  background: transparent;
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx 0;
}

.a4-container {
  position: relative;
  display: none;
  z-index: 100;
  width: 92%;
  max-width: 720rpx;
  margin: 20rpx auto 36rpx;
  transform: translateY(-80rpx);
}

.a4-container.active {
  display: block;
}

.a4-paper {
  width: 595rpx;
  min-height: 842rpx;
  height: auto;
  background: rgba(255, 255, 255, 0.9);
  border: 3rpx solid #d4d4d4;
  border-radius: 8rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.15);
  padding: 40rpx;
  box-sizing: border-box;
}

.a4-content {
  height: 100%;
}

.a4-top {
  width: 100%;
  margin-bottom: 30rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
  background: rgba(255, 255, 255, 0.45);
  backdrop-filter: blur(12rpx);
  padding: 24rpx;
  border-radius: 32rpx;
  box-shadow: 0 12rpx 40rpx rgba(0, 0, 0, 0.05);
  border: 2rpx solid rgba(255, 255, 255, 0.4);
  box-sizing: border-box;
}

.a4-top-wrap {
  position: relative;
  width: 100%;
}

.a4-top-image {
  width: 100%;
  border-radius: 24rpx;
  object-fit: cover;
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.1);
}

.a4-top-overlay {
  position: absolute;
  top: 20rpx;
  left: 20rpx;
  right: 20rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.a4-top-text {
  font-size: 30rpx;
  color: #4a4a4a;
  line-height: 1.6;
  text-align: center;
  letter-spacing: 1rpx;
  font-weight: 600;
  margin: 10rpx 0;
}

.a4-actions {
  width: 100%;
  display: flex;
  justify-content: center;
}

.a4-primary-btn {
  width: 80%;
  max-width: 400rpx;
  min-width: 220rpx;
  justify-content: center;
  margin-top: 10rpx;
  background: linear-gradient(135deg, #a8e063 0%, #56ab2f 100%);
  border: none;
  color: #fff;
  box-shadow: 0 6rpx 16rpx rgba(86, 171, 47, 0.3);
}

.a4-primary-btn .audio-text {
  color: #fff;
  font-weight: bold;
  letter-spacing: 2rpx;
}
.a4-default-image {
  position: absolute;
  bottom: -260rpx;
  right: -40rpx;
  width: 300rpx;
  height: 300rpx;
  z-index: 10000;
  animation: floatAndRotate 3s ease-in-out infinite;
  cursor: pointer;
}

@keyframes floatAndRotate {
  0% { transform: translateY(0) rotate(0deg); }
  25% { transform: translateY(-10rpx) rotate(5deg); }
  50% { transform: translateY(0) rotate(0deg); }
  75% { transform: translateY(10rpx) rotate(-5deg); }
  100% { transform: translateY(0) rotate(0deg); }
}

/* 提示便签 */
.tip-label {
  position: fixed;
  bottom: 160rpx;
  right: 160rpx; /* 增加 right 值，继续向左移动 */
  background: #ffffff;
  color: #000000;
  padding: 16rpx 24rpx;
  border-radius: 16rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.15);
  opacity: 0;
  transform: translateY(20rpx) scale(0.8);
  transition: all 0.3s ease;
  z-index: 10001; /* 比小羊层级高 */
  max-width: 300rpx;
  word-wrap: break-word;
  pointer-events: none; /* 防止遮挡点击 */
}

.tip-label.show {
  opacity: 1;
