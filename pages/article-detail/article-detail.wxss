  background: linear-gradient(135deg, #a8e063 0%, #56ab2f 100%);
  border: none;
  box-shadow: 0 6rpx 16rpx rgba(86, 171, 47, 0.3);
}
.audio-btn.primary .audio-text {
  color: #fff;
}

@keyframes modalPop {
  from { transform: scale(0.9); opacity: 0; }
  to { transform: scale(1); opacity: 1; }
}

/* 宝盒模态框 */
.treasure-modal, .treasure-ready {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 1100;
  display: flex;
  align-items: center;
  justify-content: center;
}

.treasure-mask {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.7);
  backdrop-filter: blur(5px);
}

.treasure-card {
  position: relative;
  width: 600rpx;
  min-height: 400rpx;
  background: transparent;
  display: flex;
  flex-direction: column;
  align-items: center;
  animation: modalPop 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
}

.treasure-image {
  width: 100%;
  border-radius: 20rpx;
  box-shadow: 0 10rpx 30rpx rgba(0,0,0,0.3);
}

.treasure-actions {
  margin-top: 40rpx;
}

/* 待拆盲盒 */
.treasure-ready-card {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  animation: floatBox 3s ease-in-out infinite;
}

.treasure-box {
  width: 300rpx;
  height: 300rpx;
  margin-bottom: 30rpx;
}

.treasure-box-image {
  width: 100%;
  height: 100%;
}

.treasure-box-hint {
  color: #fff;
  font-size: 32rpx;
  font-weight: bold;
  text-shadow: 0 2rpx 4rpx rgba(0,0,0,0.5);
  letter-spacing: 2rpx;
}

@keyframes floatBox {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-20rpx); }
}

/* 烦恼输入模态框 */
.custom-modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.5);
  backdrop-filter: blur(4px);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.custom-modal-content {
  width: 640rpx;
  background: #fff;
  border-radius: 30rpx;
  overflow: hidden;
  position: relative;
  box-shadow: 0 10rpx 30rpx rgba(0,0,0,0.15);
  animation: modalPop 0.3s ease-out;
}

.modal-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  opacity: 0.1;
  z-index: 0;
}

.modal-body {
  position: relative;
  z-index: 1;
  padding: 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.modal-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 30rpx;
}

.worry-input {
  width: 100%;
  height: 200rpx;
  background: #f9f9f9;
  border: 2rpx solid #eee;
  border-radius: 16rpx;
  padding: 20rpx;
  box-sizing: border-box;
  font-size: 28rpx;
  margin-bottom: 30rpx;
}

.action-btn-row {
  display: flex;
  width: 100%;
  justify-content: space-between;
  gap: 20rpx;
}

.voice-btn-container {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f0f0f0;
  border-radius: 40rpx;
  height: 80rpx;
}

.voice-icon {
  margin-right: 10rpx;
}

.voice-text {
  font-size: 25rpx;
}

.modal-btn {
  flex: 2;
  background: linear-gradient(135deg, #89e693ff 0%, #4ecd55ff 100%);
  color: #fff;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: bold;
  height: 80rpx;
  box-shadow: 0 6rpx 16rpx rgba(168, 230, 207, 0.3);
}
