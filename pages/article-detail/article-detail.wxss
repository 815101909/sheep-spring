.mode-text {
  text-align: center;
}

/* 内容面板容器 */
.content-panels {
  margin: 0 30rpx 0 30rpx;
  display: flex;
  align-items: stretch;
  justify-content: center;
  flex: 1;
  min-height: 0;
  box-sizing: border-box;
  overflow: hidden;
}

.content-panel {
  width: 100%;
  height: 100%;
  background: transparent;
  border-radius: 20rpx;
  box-shadow: 0 15rpx 35rpx rgba(0, 0, 0, 0.1);
